# Скопируйте в .env и заполните. Файл .env НЕ коммитится.
APP_ENV=dev
DATABASE_PATH=./data/finritm.sqlite3
CORS_ORIGINS=http://localhost:5173
# Фиксированная «сегодня» для демо (ГГГГ-ММ-ДД). Пусто — настоящая дата. Демо-числа сходятся при 2026-09-26.
APP_TODAY=2026-09-26
# Версия в /api/health (на хостинге — git-хеш)
GIT_SHA=dev

# LLM: fake | openai_compat | gigachat
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
GIGACHAT_CREDENTIALS=
KB_PATH=data/knowledge_base/kb.json
# Сколько вопросов помощнику в минуту на пользователя
ASK_LIMIT_PER_MINUTE=20

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=change-me-32-chars-minimum-random-string
TG_ID_SALT=change-me-random-salt
API_BASE_URL=http://localhost:8000
MINI_APP_URL=
