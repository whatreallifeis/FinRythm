# Скопируйте в .env и заполните. Файл .env НЕ коммитится.
APP_ENV=dev
DATABASE_PATH=./data/finritm.sqlite3
CORS_ORIGINS=http://localhost:5173
# Фиксированная «сегодня» для демо (ГГГГ-ММ-ДД). Пусто — настоящая дата. Демо-числа сходятся при 2026-09-26.
APP_TODAY=2026-09-26
# Версия в /api/health (на хостинге — git-хеш)
GIT_SHA=dev

# LLM: fake | openai_compat
# fake — ответы по шаблонам вокруг чисел core, без модели.
# Алиса AI (Yandex AI Studio, OpenAI-совместимый API) — docs/03_deploy.md §9:
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
#   LLM_API_KEY=<API-ключ сервисного аккаунта>          — секрет, только в .env
#   LLM_MODEL=gpt://<ID каталога>/aliceai-llm
#   OPENAI_PROJECT_ID=<ID каталога>                      — библиотека openai передаёт его Яндексу заголовком
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_PROJECT_ID=
GIGACHAT_CREDENTIALS=
# Секунд на весь ответ модели. Не успела — шаблонный ответ из тех же чисел. На медленном CPU можно поднять.
LLM_TIMEOUT=40
KB_PATH=data/knowledge_base/kb.json
# Сколько вопросов помощнику в минуту на пользователя
ASK_LIMIT_PER_MINUTE=20

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=change-me-32-chars-minimum-random-string
TG_ID_SALT=change-me-random-salt
API_BASE_URL=http://localhost:8000
MINI_APP_URL=

# ---- Сервер (deploy/compose.yml, инструкция — docs/03_deploy.md) ----
# Адрес сайта. Своего домена нет — IP через sslip.io: 203.0.113.10 → 203-0-113-10.sslip.io
SITE_ADDRESS=
# Пароль на сайт и Swagger (тестовый стенд не должен быть публичным)
BASIC_AUTH_USER=team
# Хеш пароля: docker run --rm caddy:2 caddy hash-password --plaintext 'ваш-пароль'
# Значение — ОБЯЗАТЕЛЬНО в одинарных кавычках: в хеше есть символы $
BASIC_AUTH_HASH=
