# Базовый URL бэкенда. Пока пусто — приложение работает на моках.
VITE_API_URL=

# true  — все запросы уходят в src/shared/api/mock (режим для UI-разработки)
# false — запросы уходят на VITE_API_URL
VITE_USE_MOCK=true

# ВАЖНО: всё, что начинается с VITE_, попадает в бандл открытым текстом.
# Никаких токенов, ключей LLM и секретов бота здесь быть не должно.
